<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_refresh_guard_states" model="ir.cron">
        <field name="name">Instance Guard: refresh the state of managed instances</field>
        <field name="model_id" ref="model_dbc_guard_instance"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_states()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>

</odoo>
