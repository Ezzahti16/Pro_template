<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_guard_console" model="ir.module.category">
        <field name="name">Database Guard Console</field>
        <field name="description">Central control of the database manager protection of managed Odoo instances.</field>
        <field name="sequence">90</field>
    </record>

    <record id="res_groups_privilege_guard_console" model="res.groups.privilege">
        <field name="name">Database Guard Console</field>
        <field name="category_id" ref="module_category_guard_console"/>
        <field name="sequence">90</field>
    </record>

    <record id="group_guard_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="res_groups_privilege_guard_console"/>
        <field name="comment">Can see the managed instances and their state, without the credentials.</field>
    </record>

    <record id="group_guard_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_guard_console"/>
        <field name="implied_ids" eval="[Command.link(ref('group_guard_viewer'))]"/>
        <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
        <field name="comment">Can register instances, hold their API keys and push the protection settings.</field>
    </record>

</odoo>
