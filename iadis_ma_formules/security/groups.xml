<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_ma_formules" model="ir.module.category">
            <field name="name">Morocco Fiscal Formules</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_ma_formules_user" model="res.groups">
            <field name="name">Fiscal Formules / User (read)</field>
            <field name="category_id" ref="module_category_ma_formules"/>
        </record>

        <record id="group_ma_formules_manager" model="res.groups">
            <field name="name">Fiscal Formules / Manager (edit)</field>
            <field name="category_id" ref="module_category_ma_formules"/>
            <field name="implied_ids" eval="[(4, ref('group_ma_formules_user'))]"/>
        </record>
    </data>
</odoo>
