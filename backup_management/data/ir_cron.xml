<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Odoo 18 : ir.cron _inherits ir.actions.server.
             Les champs 'state'/'code' viennent de l'action serveur.
             numbercall/doall N'EXISTENT PLUS depuis Odoo 16. -->
        <record id="ir_cron_drive_backup" model="ir.cron">
            <field name="name">Google Drive : backup automatique</field>
            <field name="model_id" ref="model_backup_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_backups()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- Desactive par defaut : a activer apres configuration -->
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
