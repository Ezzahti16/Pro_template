<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_backup_log_list" model="ir.ui.view">
        <field name="name">backup.log.list</field>
        <field name="model">backup.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="config_id"/>
                <field name="status"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'failed'"/>
                <field name="file_size"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="action_backup_log" model="ir.actions.act_window">
        <field name="name">Logs Backup</field>
        <field name="res_model">backup.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
