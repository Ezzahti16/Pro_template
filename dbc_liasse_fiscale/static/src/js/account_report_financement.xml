<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <!--
        "Tableau de Financement de l'Exercice" (report 50) is the only
        report of this module made of two tables with different column
        layouts. account.report's stock screen only supports a single
        table/column layout, so this template is a copy of
        account_reports.AccountReportCustomizable (control panel, filters,
        search bar, cog menu, warnings, chatter, everything) with only the
        "Table" section changed to render two <table> elements instead of
        one - one per group of columns/lines ("a"-"d" for the "Synthese des
        masses du bilan" table, "emplois_n"-"ressources_n1" for the "Emplois
        et Ressources" table).

        It is wired in via custom_display_config.templates.AccountReport,
        set only for bilan_financement_report by
        AccountReportHandlerMaFiscal_Financement._custom_options_initializer
        (models/account_report_financement.py) - see account_report.js /
        getTemplate() in account_reports for the mechanism.

        AccountReportLine/AccountReportLineCell render each line from its
        own self-contained `columns` array (no reliance on the report-wide
        controller.options.columns), so passing a sliced `columns` array per
        table works without any further patch to those components.
    -->
    <t t-name="dbc_liasse_fiscale.AccountReportFinancementCustomizable">
        <div class="o_action account_report" t-att-class="cssCustomClass" t-ref="root" t-on-keydown="onKeydown">
            <ControlPanel>
                <!-- Buttons bar -->
                <t t-set-slot="control-panel-create-button">
                    <AccountReportButtonsBar/>
                </t>
                <t t-set-slot="control-panel-additional-actions">
                    <AccountReportCogMenu/>
                </t>

                <!-- Search bar (if configured for report) and filters -->
                <t t-set-slot="layout-actions">
                   <div class="d-flex gap-1 flex-wrap">
                       <t t-if="controller.cachedFilterOptions.search_bar">
                           <AccountReportSearchBar initialQuery="initialQuery"/>
                           <br/>
                       </t>
                       <t t-component="env.component('AccountReportFilters')"/>
                   </div>
                </t>

                <t t-set-slot="control-panel-navigation-additional" t-if="controller.chatterState.lineId">
                    <button
                        t-on-click="() => controller.closeChatter()"
                        data-tooltip="Chatter"
                        class="btn btn-secondary o_switch_view o_kanban d-none d-md-inline"
                        t-att-class="{'active': controller.chatterState.model}">
                            <i t-attf-class="fa fa-fw {{ controller.chatterState.model ? 'fa-close' : 'fa-comments-o' }} mt-1"/>
                    </button>
                </t>
            </ControlPanel>

            <div class="overflow-hidden d-flex flex-row h-100">
                <div class="o_content d-flex flex-column w-100">
                    <!-- Sections -->
                    <t t-if="controller.cachedFilterOptions.sections.length">
                        <div id="section_selector" class="section_selector">
                            <t t-foreach="controller.cachedFilterOptions.sections" t-as="section" t-key="section_index">
                                <button
                                    t-att-class="(controller.cachedFilterOptions.selected_section_id === section.id) ? 'btn btn-secondary' : 'btn btn-primary'"
                                    t-on-click="() => controller.switchToSection(section.id)"
                                    t-out="section.name"
                                />
                            </t>

                            <t t-if="controller.cachedFilterOptions['has_inactive_sections']">
                                <button class="btn btn-secondary" t-on-click="(ev) => controller.reportAction(ev, 'action_display_inactive_sections')" >+</button>
                            </t>
                        </div>
                    </t>

                    <!-- Warnings -->
                    <t t-if="controller.data and controller.warnings">
                        <div id="warnings" class="warnings d-print-none">
                            <t t-foreach="controller.warnings" t-as="warningTemplateRef" t-key="warningTemplateRef">
                                <t t-set="warningParams" t-value="controller.warnings[warningTemplateRef]"/>

                                <div t-att-class="`alert alert-${warningParams['alert_type'] || 'info'} text-center`">
                                    <t t-call="{{ warningTemplateRef }}"/>
                                </div>
                            </t>
                        </div>
                    </t>

                    <t t-if="controller.data === undefined">
                        <div class="o_view_nocontent">
                            <div class="text-center mt-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-elif="controller.lines.length">
                        <!--
                            Two tables: "Synthese des masses du bilan" (columns 0-3) then
                            "Emplois et Ressources" (columns 4-7). line.code is only sent to
                            the client in export mode, so the split between the two tables'
                            lines is done on their index in controller.lines instead, using
                            the count of table-1 lines passed via
                            custom_display_config.ma_financement_table1_count (table 1's
                            lines are always defined first, see bilan_financement_report.xml).
                        -->
                        <t t-set="table1Count" t-value="controller.options.custom_display_config.ma_financement_table1_count || 0"/>
                        <div class="mx-auto fit-content w-print-100 o_account_report_scroll_container overflow-x-auto">
                            <h6 class="o_ma_financement_table_title">Synthèse des masses du bilan</h6>
                            <table class="table table-borderless table-hover w-print-100 mx-auto" t-att-class="tableClasses">
                                <thead>
                                    <tr class="border-bottom">
                                        <th/>
                                        <t t-foreach="controller.options.columns.slice(0, 4)" t-as="col" t-key="col_index">
                                            <th class="text-end"><t t-esc="col.name"/></th>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="controller.lines" t-as="line" t-key="line_index">
                                        <t t-if="line_index &lt; table1Count">
                                            <t t-component="env.component('AccountReportLine')"
                                               t-props="{ lineIndex: line_index, line: Object.assign({}, line, { columns: line.columns.slice(0, 4) }) }"/>
                                        </t>
                                    </t>
                                </tbody>
                            </table>

                            <h6 class="o_ma_financement_table_title mt-4">Emplois et Ressources</h6>
                            <table class="table table-borderless table-hover w-print-100 mx-auto" t-att-class="tableClasses">
                                <thead>
                                    <tr class="border-bottom">
                                        <th/>
                                        <t t-foreach="controller.options.columns.slice(4, 8)" t-as="col" t-key="col_index">
                                            <th class="text-end"><t t-esc="col.name"/></th>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="controller.lines" t-as="line" t-key="line_index">
                                        <t t-if="line_index &gt;= table1Count">
                                            <t t-component="env.component('AccountReportLine')"
                                               t-props="{ lineIndex: line_index, line: Object.assign({}, line, { columns: line.columns.slice(4, 8) }) }"/>
                                        </t>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                    <t t-else="">
                        <!-- No content -->
                        <div class="o_view_nocontent">
                            <div class="o_nocontent_help">
                                <p class="o_view_nocontent_neutral_face">No data to display !</p>
                                <p>There is no data to display for the given filters.</p>
                            </div>
                        </div>
                    </t>
                </div>

                <div t-att-class="{'o_account_report_chatter_hidden': !controller.chatterState.id or ui.isSmall}"
                     class="o_account_report_chatter o-mail-ChatterContainer h-100 o-aside d-flex flex-column">
                    <t t-if="controller.chatterState.model">
                        <AccountReportChatter
                            threadModel="controller.chatterState.model"
                            threadId="controller.chatterState.id"
                            isChatterAside="!ui.isSmall"
                            reportController="controller"
                            date_to="controller.options.date.date_to"
                        />
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
