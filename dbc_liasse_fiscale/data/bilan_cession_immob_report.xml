<?xml version="1.0" encoding="utf-8"?><odoo>

<!-- "Tableau des Plus ou Moins Values sur Cessions ou Retraits
     d'Immobilisations" (tableau n° 10) - a DATA-ENTRY report, same
     concept as bilan_capital_report.xml / bilan_titres_report.xml /
     bilan_rental_report.xml: no EDI code or formula behind any cell,
     rows are entirely dynamic (see AccountReportHandlerMaCession /
     AccountReportHandlerMaDataEntry in models/account_report.py).

     It used to be a single static "TOTAL" row reading the codes
     2037-2043. Those codes are nothing but EDIST('1931')..EDIST('1936'),
     i.e. the column sums of a per-disposal DETAIL grid (codes 1929-1936,
     'T10'!$A$10:$H$19) that has no formula of its own anywhere - a
     cession is keyed in by the preparer, it cannot be derived from the
     balance. So the row read 0 for ever and there was no way to fill it.
     The detail grid now IS the report, and its "Totaux" line is what
     carries 2038-2043 (see _ANNEX_TABLES/_ANNEX_TOTALS for tableau 38 in
     dbc_liasse_edi/models/account_report.py, exactly like tableaux 12,
     23, 27, 28, 39 and 41).

     Columns and their order are the reference liasse's own
     (BILAN.xlsx!PlusValue A6:I6 = 'Liasse ExcelToXml'!T10!A9:H9), and the
     six numeric ones are summable=True - the legacy sheet sums every one
     of them on its TOTAL row (T10!C20..H20). Valeur nette, Plus values
     and Moins values are read-only: the grid computes them from the other
     columns (E =C-D, G =IF(F>E,F-E,""), H =IF(F<E,E-F,"")).

     Rows are scoped by their own "Année fiscale" field, picked in the
     create/edit popup, which is what the date filter matches against. -->
<record id="bilan_cession_immob_report" model="account.report">
    <field name="name">Tableau des Plus ou Moins Values sur Cessions ou Retraits d'Immobilisations</field>
    <field name="country_id" ref="base.ma"/>
    <field name="filter_date_range" eval="False"/>
    <field name="filter_analytic_groupby" eval="False"/>
    <field name="filter_journals" eval="False"/>
    <field name="filter_show_draft" eval="False"/>
    <field name="filter_unfold_all" eval="False"/>
    <field name="filter_multi_company">selector</field>
    <field name="filter_period_comparison" eval="False"/>
    <field name="filter_growth_comparison" eval="False"/>
    <field name="allow_account_audit_status_on_lines" eval="False"/>
    <field name="custom_handler_model_id" ref="model_account_report_handler_ma_cession"/>
    <field name="column_ids">
        <record id="bilan_cession_column_date_cession" model="account.report.column">
            <field name="name">Date de cession ou de retrait</field>
            <field name="expression_label">date_cession</field>
            <field name="sequence">10</field>
            <field name="figure_type">date</field>
        </record>
        <record id="bilan_cession_column_compte_principal" model="account.report.column">
            <field name="name">Compte principal</field>
            <field name="expression_label">compte_principal</field>
            <field name="sequence">20</field>
            <field name="figure_type">string</field>
        </record>
        <record id="bilan_cession_column_montant_brut" model="account.report.column">
            <field name="name">Montant brut</field>
            <field name="expression_label">montant_brut</field>
            <field name="sequence">30</field>
            <field name="figure_type">float</field>
        </record>
        <record id="bilan_cession_column_amort_cumules" model="account.report.column">
            <field name="name">Amortissements cumulés</field>
            <field name="expression_label">amort_cumules</field>
            <field name="sequence">40</field>
            <field name="figure_type">float</field>
        </record>
        <record id="bilan_cession_column_valeur_nette" model="account.report.column">
            <field name="name">Valeur nette d'amortissements</field>
            <field name="expression_label">valeur_nette</field>
            <field name="sequence">50</field>
            <field name="figure_type">float</field>
        </record>
        <record id="bilan_cession_column_produit_cession" model="account.report.column">
            <field name="name">Produit de cession</field>
            <field name="expression_label">produit_cession</field>
            <field name="sequence">60</field>
            <field name="figure_type">float</field>
        </record>
        <record id="bilan_cession_column_plus_values" model="account.report.column">
            <field name="name">Plus values</field>
            <field name="expression_label">plus_values</field>
            <field name="sequence">70</field>
            <field name="figure_type">float</field>
        </record>
        <record id="bilan_cession_column_moins_values" model="account.report.column">
            <field name="name">Moins values</field>
            <field name="expression_label">moins_values</field>
            <field name="sequence">80</field>
            <field name="figure_type">float</field>
        </record>
        <record id="bilan_cession_column_actions" model="account.report.column">
            <field name="name"></field>
            <field name="expression_label">ma_actions</field>
            <field name="sequence">90</field>
            <field name="figure_type">string</field>
        </record>
    </field>
</record>

<record id="action_dbc_bilan_cession_immob_report" model="ir.actions.client">
    <field name="name">Tableau des Plus ou Moins Values sur Cessions ou Retraits d'Immobilisations</field>
    <field name="tag">account_report</field>
    <field name="path">dbc-bilan-cession-immob</field>
    <field name="context" eval="{'report_id': ref('bilan_cession_immob_report')}"/>
</record>
<menuitem id="menu_dbc_bilan_cession_immob_report" name="Plus ou Moins Values sur Cessions d'Immobilisations" parent="account.account_reports_legal_statements_menu" action="action_dbc_bilan_cession_immob_report" sequence="35"/>

</odoo>
