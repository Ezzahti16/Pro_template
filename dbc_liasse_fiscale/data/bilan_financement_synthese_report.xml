<?xml version="1.0" encoding="utf-8"?><odoo>

    <!--
        Table I of the "Tableau de Financement de l'Exercice" (report 50):
        "Synthèse des masses du bilan".
        This is a normal, self-contained account.report (same engine as every
        other report of this module) but it is never opened on its own: it is
        combined with bilan_financement_emplois_report by the "Tableau de
        Financement" combined screen/xlsx (see bilan_financement_report.xml
        and models/account_report_financement.py) since Odoo's account.report
        only supports one column layout per screen.
    -->
    <record id="bilan_financement_synthese_report" model="account.report">
        <field name="name">Synthèse des masses du bilan</field>
        <field name="country_id" ref="base.ma"/>
        <field name="default_opening_date_filter">today</field>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_analytic_groupby" eval="False"/>
        <field name="filter_journals" eval="False"/>
        <field name="filter_show_draft" eval="True"/>
        <field name="filter_unfold_all" eval="False"/>
        <field name="filter_multi_company">selector</field>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_growth_comparison" eval="False"/>
        <field name="allow_account_audit_status_on_lines" eval="True"/>
        <field name="custom_handler_model_id" ref="model_account_report_handler_ma_fiscal"/>
        <field name="column_ids">
            <record id="bilan_financement_synthese_column_a" model="account.report.column">
                <field name="name">(a) Exercice</field>
                <field name="expression_label">a</field>
                <field name="sequence">10</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="bilan_financement_synthese_column_b" model="account.report.column">
                <field name="name">(b) Exercice précédent</field>
