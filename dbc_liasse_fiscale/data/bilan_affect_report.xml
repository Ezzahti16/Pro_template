<?xml version="1.0" encoding="utf-8"?><odoo>

<record id="bilan_affect_report" model="account.report">
    <field name="name">Affectation des Résultats Intervenus au Cours de l’Exercice</field>
    <field name="country_id" ref="base.ma"/>
    <field name="default_opening_date_filter">today</field>
    <field name="filter_date_range" eval="True"/>
    <field name="filter_analytic_groupby" eval="False"/>
    <field name="filter_journals" eval="False"/>
    <field name="filter_show_draft" eval="True"/>
    <field name="filter_unfold_all" eval="False"/>
    <field name="filter_multi_company">selector</field>
    <field name="filter_period_comparison" eval="True"/>
    <field name="filter_growth_comparison" eval="False"/>
    <field name="allow_account_audit_status_on_lines" eval="True"/>
