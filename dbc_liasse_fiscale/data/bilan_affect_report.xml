                <field name="code">AFFECT_REPORT_NOUVEAU</field>
                <field name="hierarchy_level">1</field>
                <field name="sequence">2</field>
                <field name="expression_ids">
                    <record id="bilan_affect_expr_report_nouveau_montant" model="account.report.expression">
                        <field name="label">montant</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_custom_engine_ma_fiscal</field>
                        <field name="subformula">edi_471</field>
                        <field name="date_scope">from_beginning</field>
                    </record>
