<?xml version="1.0" encoding="utf-8"?><odoo>

<!-- "Répartition du Capital Social" - unlike every other bilan_* report
     here, this one has no EDI code or formula behind any cell: its rows
     (one per associate) are entirely dynamic, generated by
     AccountReportHandlerMaCapital from ma.fiscal.capital.line records that
     the user creates/edits/deletes straight from the report's own
     add/edit/delete popups (see models/account_report.py and
     static/src/js/capital_line_popover.*). There is deliberately no
     line_ids here, same as Odoo's own Partner Ledger/General Ledger.

     The rows themselves are NOT scoped by date or account at all (see
     AccountReportHandlerMaCapital._dynamic_lines_generator, which filters
     only by company) - every account.report still carries Odoo's own
     mandatory internal date context (the framework's column/period
     plumbing hard-depends on it), so the small date widget stays in the
     top bar, but changing it has no effect on which rows show here.
     filter_date_range=False at least keeps that widget to a single plain
     date instead of a from/to range. -->
<record id="bilan_capital_report" model="account.report">
    <field name="name">État de Répartition du Capital Social</field>
    <field name="country_id" ref="base.ma"/>
    <field name="filter_date_range" eval="False"/>
    <field name="filter_analytic_groupby" eval="False"/>
    <field name="filter_journals" eval="False"/>
    <field name="filter_show_draft" eval="False"/>
    <field name="filter_unfold_all" eval="False"/>
    <field name="filter_multi_company">selector</field>
    <field name="filter_period_comparison" eval="False"/>
    <field name="filter_growth_comparison" eval="False"/>
    <field name="custom_handler_model_id" ref="model_account_report_handler_ma_capital"/>
    <field name="column_ids">
        <record id="bilan_capital_column_nom_prenom" model="account.report.column">
            <field name="name">Nom et prénom</field>
            <field name="expression_label">nom_prenom</field>
            <field name="sequence">10</field>
            <field name="figure_type">string</field>
        </record>
        <record id="bilan_capital_column_raison_sociale" model="account.report.column">
            <field name="name">Raison sociale</field>
            <field name="expression_label">raison_sociale</field>
            <field name="sequence">20</field>
            <field name="figure_type">string</field>
        </record>
        <record id="bilan_capital_column_num_if" model="account.report.column">
            <field name="name">N° IF</field>
            <field name="expression_label">num_if</field>
            <field name="sequence">30</field>
            <field name="figure_type">string</field>
        </record>
        <record id="bilan_capital_column_num_cin" model="account.report.column">
            <field name="name">N° CIN</field>
            <field name="expression_label">num_cin</field>
            <field name="sequence">40</field>
            <field name="figure_type">string</field>
        </record>
        <record id="bilan_capital_column_num_ce" model="account.report.column">
            <field name="name">N° Carte d'étranger</field>
            <field name="expression_label">num_ce</field>
            <field name="sequence">50</field>
            <field name="figure_type">string</field>
        </record>
        <record id="bilan_capital_column_adresse" model="account.report.column">
            <field name="name">Adresse</field>
            <field name="expression_label">adresse</field>
            <field name="sequence">60</field>
            <field name="figure_type">string</field>
        </record>
        <record id="bilan_capital_column_titres_precedent" model="account.report.column">
            <field name="name">Titres (N-1)</field>
            <field name="expression_label">titres_precedent</field>
            <field name="sequence">70</field>
            <field name="figure_type">integer</field>
        </record>
        <record id="bilan_capital_column_titres_actuel" model="account.report.column">
            <field name="name">Titres (N)</field>
            <field name="expression_label">titres_actuel</field>
            <field name="sequence">80</field>
            <field name="figure_type">integer</field>
        </record>
        <record id="bilan_capital_column_valeur_nominale" model="account.report.column">
            <field name="name">Valeur nominale</field>
            <field name="expression_label">valeur_nominale</field>
            <field name="sequence">90</field>
            <field name="figure_type">float</field>
        </record>
        <record id="bilan_capital_column_montant_souscrit" model="account.report.column">
            <field name="name">Capital souscrit</field>
            <field name="expression_label">montant_souscrit</field>
            <field name="sequence">100</field>
            <field name="figure_type">float</field>
        </record>
        <record id="bilan_capital_column_montant_appele" model="account.report.column">
            <field name="name">Capital appelé</field>
            <field name="expression_label">montant_appele</field>
            <field name="sequence">110</field>
            <field name="figure_type">float</field>
        </record>
        <record id="bilan_capital_column_montant_libere" model="account.report.column">
            <field name="name">Capital libéré</field>
            <field name="expression_label">montant_libere</field>
            <field name="sequence">120</field>
            <field name="figure_type">float</field>
        </record>
        <record id="bilan_capital_column_actions" model="account.report.column">
            <field name="name"></field>
            <field name="expression_label">ma_actions</field>
            <field name="sequence">130</field>
            <field name="figure_type">string</field>
        </record>
    </field>
</record>

<record id="action_ma_bilan_capital_report" model="ir.actions.client">
    <field name="name">Répartition du Capital Social</field>
    <field name="tag">account_report</field>
    <field name="path">ma-bilan-capital</field>
    <field name="context" eval="{'report_id': ref('bilan_capital_report')}"/>
</record>

<menuitem id="menu_ma_bilan_capital_report" name="Répartition du Capital Social" action="action_ma_bilan_capital_report" parent="account.account_reports_legal_statements_menu" sequence="13"/>
</odoo>
