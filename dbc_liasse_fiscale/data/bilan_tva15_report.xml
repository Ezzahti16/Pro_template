<?xml version="1.0" encoding="utf-8"?><odoo>

<record id="bilan_tva15_report" model="account.report">
    <field name="name">Détail de la Taxe sur la Valeur Ajoutée</field>
    <field name="country_id" ref="base.ma"/>
    <field name="default_opening_date_filter">today</field>
    <field name="filter_date_range" eval="True"/>
    <field name="filter_analytic_groupby" eval="False"/>
    <field name="filter_journals" eval="False"/>
    <field name="filter_show_draft" eval="True"/>
    <field name="filter_unfold_all" eval="False"/>
    <field name="filter_multi_company">selector</field>
    <field name="filter_period_comparison" eval="True"/>
    <field name="filter_growth_comparison" eval="False"/>
    <field name="allow_account_audit_status_on_lines" eval="True"/>
    <field name="custom_handler_model_id" ref="model_account_report_handler_ma_fiscal"/>
    <field name="column_ids">
        <record id="bilan_tva15_column_solde_debut" model="account.report.column">
            <field name="name">Solde au début de l'exercice</field>
            <field name="expression_label">solde_debut</field>
            <field name="sequence">10</field>
            <field name="figure_type">monetary</field>
        </record>
        <record id="bilan_tva15_column_operations" model="account.report.column">
            <field name="name">Opérations comptables de l'exercice</field>
            <field name="expression_label">operations</field>
            <field name="sequence">20</field>
            <field name="figure_type">monetary</field>
        </record>
        <record id="bilan_tva15_column_declarations" model="account.report.column">
            <field name="name">Déclarations T.V.A de l'exercice</field>
            <field name="expression_label">declarations</field>
            <field name="sequence">30</field>
            <field name="figure_type">monetary</field>
        </record>
        <record id="bilan_tva15_column_fin" model="account.report.column">
            <field name="name">Solde fin d'exercice (1+2-3=4)</field>
            <field name="expression_label">fin</field>
            <field name="sequence">40</field>
            <field name="figure_type">monetary</field>
        </record>
        <record id="bilan_tva15_column_ecart" model="account.report.column">
            <field name="name">ECART</field>
            <field name="expression_label">ecart</field>
            <field name="sequence">50</field>
            <field name="figure_type">monetary</field>
        </record>
    </field>
