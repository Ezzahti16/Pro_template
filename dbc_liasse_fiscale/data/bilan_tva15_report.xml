                <field name="code">TVA15_A_FACTUREE</field>
                <field name="hierarchy_level">1</field>
                <field name="sequence">1</field>
                <field name="expression_ids">
                    <record id="bilan_tva15_expr_a_facturee_solde_debut" model="account.report.expression">
                        <field name="label">solde_debut</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_custom_engine_ma_fiscal</field>
                        <field name="subformula">edi_2065</field>
                        <field name="date_scope">to_beginning_of_period</field>
