<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ma_fiscal_formula_log_list" model="ir.ui.view">
        <field name="name">ma.fiscal.formula.log.list</field>
        <field name="model">ma.fiscal.formula.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Date"/>
                <field name="user_id"/>
                <field name="edi_code"/>
                <field name="year"/>
                <field name="client_id"/>
                <field name="old_formula"/>
                <field name="new_formula"/>
            </list>
        </field>
    </record>

    <record id="ma_fiscal_formula_log_action" model="ir.actions.act_window">
        <field name="name">Historique des formules</field>
        <field name="res_model">ma.fiscal.formula.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_ma_fiscal_formula_log"
              name="Historique des formules"
              action="ma_fiscal_formula_log_action"
              parent="account.account_reports_legal_statements_menu"
              groups="dbc_liasse_fiscale.group_ma_fiscal_reports_enabled"
              sequence="100"/>

</odoo>
