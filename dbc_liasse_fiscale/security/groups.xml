<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The Moroccan fiscal report menus are always visible (no `groups=`
        attribute on them) and work out of the box with the shared master
        formulas. This group instead sits underneath
        group_ma_fiscal_formula_editor in its implied_ids, so an editor
        automatically also gets the normal accounting read access it needs.

        Membership of this group is managed entirely in code, not by hand:
        toggling "Activer les formules modifiables" in Settings adds/removes
        every user currently in account.group_account_readonly from this
        group (see ResConfigSettings._ma_sync_reports_group).
    -->
    <record id="group_ma_fiscal_reports_enabled" model="res.groups">
        <field name="name">Rapports Fiscaux Maroc - Activé</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>

    <!--
        Gates the formula-edit pin icon (see
        AccountReport_MaFiscal._build_static_line_columns /
        action_modify_formula in models/account_report.py). Unlike the group
        above, membership here is managed by hand - not every user who can
        see the reports should be able to rewrite the formulas behind them.
        Assign it from Settings > Users & Companies > Groups (enable
        developer mode first) by adding users to "Rapports Fiscaux Maroc -
        Editeur de formules". implied_ids ensures an editor automatically
        also gets view access.
    -->
    <record id="group_ma_fiscal_formula_editor" model="res.groups">
        <field name="name">Rapports Fiscaux Maroc - Editeur de formules</field>
        <field name="implied_ids" eval="[(4, ref('group_ma_fiscal_reports_enabled'))]"/>
    </record>

</odoo>
