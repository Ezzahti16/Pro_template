#. module: dbc_bulk_confirm_entries
#: model:ir.actions.server,name:dbc_bulk_confirm_entries.action_confirm_draft_entries
msgid "Confirm Draft Entries"
msgstr "Confirmer les écritures brouillon"

#. module: dbc_bulk_confirm_entries
#. odoo-python
#: code:addons/dbc_bulk_confirm_entries/models/account_move.py:0
msgid "Entries confirmed"
msgstr "Écritures confirmées"

#. module: dbc_bulk_confirm_entries
#. odoo-python
#: code:addons/dbc_bulk_confirm_entries/models/account_move.py:0
msgid "None of the selected entries is in draft state."
