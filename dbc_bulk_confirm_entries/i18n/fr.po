#. module: dbc_bulk_confirm_entries
#. odoo-python
#: code:addons/dbc_bulk_confirm_entries/models/account_move.py:0
msgid "Bulk confirmation failed"
msgstr "Échec de la confirmation groupée"

#. module: dbc_bulk_confirm_entries
#. odoo-python
#: code:addons/dbc_bulk_confirm_entries/models/account_move.py:0
msgid "Bulk confirmation partially done"
msgstr "Confirmation groupée partiellement effectuée"

#. module: dbc_bulk_confirm_entries
#. odoo-python
#: code:addons/dbc_bulk_confirm_entries/models/account_move.py:0
