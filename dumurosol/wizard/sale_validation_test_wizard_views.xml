<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_validation_test_wizard_form" model="ir.ui.view">
        <field name="name">dumurosol.sale.validation.test.wizard.form</field>
        <field name="model">dumurosol.sale.validation.test.wizard</field>
        <field name="arch" type="xml">
            <form string="Tester cette configuration">
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="amount"/>
                        <field name="partner_id"/>
                        <field name="max_discount"/>
                    </group>
                    <group>
                        <field name="product_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <field name="result_summary" readonly="1"
                       invisible="not result_summary"
                       nolabel="1"
                       class="mt-3 p-3 border rounded bg-light"/>
                <footer>
                    <button name="action_run_simulation" type="object"
                            string="Lancer la simulation" class="btn-primary"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_validation_test_wizard" model="ir.actions.act_window">
        <field name="name">Tester une configuration de règles</field>
        <field name="res_model">dumurosol.sale.validation.test.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
