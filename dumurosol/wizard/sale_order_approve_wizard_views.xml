<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_approve_wizard_form" model="ir.ui.view">
        <field name="name">dumurosol.sale.order.approve.wizard.form</field>
        <field name="model">dumurosol.sale.order.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Valider le devis">
                <field name="sale_order_id" invisible="1"/>
                <group>
                    <field name="remark" nolabel="0" string="Remarque (visible par tous, facultative)"
                           placeholder="Ajoutez un commentaire si nécessaire (optionnel)..."/>
                </group>
                <footer>
                    <button name="action_confirm_approve" type="object"
                            string="Confirmer la validation" class="btn-success"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_order_approve_wizard" model="ir.actions.act_window">
        <field name="name">Valider le devis</field>
        <field name="res_model">dumurosol.sale.order.approve.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
