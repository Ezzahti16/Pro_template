<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue Pivot sur le journal des décisions : délais, taux de rejet, charge par validateur -->
    <record id="view_sale_validation_log_pivot" model="ir.ui.view">
        <field name="name">dumurosol.sale.validation.log.pivot</field>
        <field name="model">dumurosol.sale.validation.log</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des validations">
                <field name="validator_user_id" type="row"/>
                <field name="decision" type="col"/>
                <field name="decision_date" interval="month" type="row"/>
            </pivot>
        </field>
    </record>

    <!-- Vue Graphique -->
    <record id="view_sale_validation_log_graph" model="ir.ui.view">
        <field name="name">dumurosol.sale.validation.log.graph</field>
        <field name="model">dumurosol.sale.validation.log</field>
        <field name="arch" type="xml">
            <graph string="Analyse des validations" type="bar">
                <field name="rule_id"/>
                <field name="decision" type="col"/>
            </graph>
        </field>
    </record>

    <record id="action_sale_validation_dashboard" model="ir.actions.act_window">
        <field name="name">Analyse des validations</field>
        <field name="res_model">dumurosol.sale.validation.log</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_group_rule': 1}</field>
    </record>

    <!-- Vue Pivot complémentaire : devis par statut / client / catégorie -->
    <record id="view_sale_order_validation_pivot" model="ir.ui.view">
        <field name="name">sale.order.validation.pivot</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <pivot string="Devis par état de validation">
                <field name="partner_id" type="row"/>
                <field name="validation_state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_sale_order_validation_dashboard" model="ir.actions.act_window">
        <field name="name">Devis par statut de validation</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('validation_state', '!=', 'none')]</field>
        <field name="context">{'search_default_group_validation_state': 1}</field>
    </record>

</odoo>
