<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Multi-société : chaque règle n'est visible que dans sa société -->
        <record id="rule_sale_validation_rule_company" model="ir.rule">
            <field name="name">Règle de validation devis : multi-société</field>
            <field name="model_id" ref="model_dumurosol_sale_validation_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Validateur : ne voit que les devis où il est validateur du niveau
             courant, SAUF si le devis est le sien (le créateur garde toujours
             l'accès à ses propres devis, quel que soit son statut de
             validateur par ailleurs). -->
        <record id="rule_sale_order_validation_visibility" model="ir.rule">
            <field name="name">Devis en attente : visibilité restreinte au validateur courant</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">
                ['|', '|',
                 ('validation_state', '!=', 'pending'),
                 ('create_uid', '=', user.id),
                 ('current_validation_level_id.user_ids', 'in', [user.id])]
            </field>
            <field name="groups" eval="[(4, ref('group_sale_validation_user'))]"/>
        </record>

        <!-- Journal des décisions : cloisonné par société -->
        <record id="rule_sale_validation_log_company" model="ir.rule">
            <field name="name">Journal de validation devis : multi-société</field>
            <field name="model_id" ref="model_dumurosol_sale_validation_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
