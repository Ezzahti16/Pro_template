<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM VIEW -->
    <record id="view_sale_validation_rule_form" model="ir.ui.view">
        <field name="name">dumurosol.sale.validation.rule.form</field>
        <field name="model">dumurosol.sale.validation.rule</field>
        <field name="arch" type="xml">
            <form string="Règle de validation">
                <header>
                    <button name="action_activate" type="object" string="Activer"
                            class="oe_highlight" invisible="state == 'active'"/>
                    <button name="action_deactivate" type="object" string="Désactiver"
                            invisible="state != 'active'"/>
                    <button name="action_set_draft" type="object" string="Repasser en brouillon"
                            invisible="state == 'draft'"/>
                    <button name="action_test_rule" type="object" string="Tester cette configuration"
                            class="btn-secondary"/>
                    <button name="action_duplicate_rule" type="object" string="Dupliquer"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="En conflit" bg_color="text-bg-danger"
                            invisible="not has_conflict"/>
                    <widget name="web_ribbon" title="Règle par défaut" bg_color="text-bg-info"
                            invisible="not is_default_rule"/>
                    <div class="oe_title">
                        <label for="name" string="Nom de la règle"/>
                        <h1><field name="name" placeholder="ex: Devis client &gt; 50 000 DH"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_default_rule"/>
                            <field name="usage_count"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <div class="alert alert-danger" role="alert" invisible="not has_conflict">
                        <strong>Conflit détecté</strong> avec :
                        <field name="conflict_rule_ids" widget="many2many_tags" readonly="1"/>
                    </div>

                    <notebook>
                        <page string="Critères de déclenchement" name="criteria">
                            <group string="a) Montant HT">
                                <field name="use_amount_criteria"/>
                                <group invisible="not use_amount_criteria" col="2">
                                    <field name="amount_min" string="Borne minimale (incluse)"/>
                                    <field name="amount_max" string="Borne maximale (incluse, vide = infini)"/>
                                </group>
                            </group>
                            <group string="b) Client">
                                <field name="use_customer_criteria"/>
                                <group invisible="not use_customer_criteria">
                                    <field name="partner_ids" widget="many2many_tags"/>
                                    <field name="partner_category_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <group string="c) Produit / catégorie de produits">
                                <field name="use_product_criteria"/>
                                <group invisible="not use_product_criteria">
                                    <field name="product_ids" widget="many2many_tags"/>
                                    <field name="product_category_ids" widget="many2many_tags"/>
                                    <field name="include_child_categories"/>
                                </group>
                            </group>
                            <group string="d) Remise">
                                <field name="use_discount_criteria"/>
                                <group invisible="not use_discount_criteria">
                                    <field name="min_discount_percent" string="Remise minimale déclenchante (%)"/>
                                </group>
                            </group>
                        </page>
                        <page string="Circuit de validation" name="circuit">
                            <field name="level_count" invisible="1"/>
                            <field name="level_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="sla_hours"/>
                                    <field name="escalation_hours"/>
                                    <field name="escalation_user_id"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="sequence"/>
                                            <field name="user_ids" widget="many2many_tags"/>
                                        </group>
                                    </group>
                                    <group string="Délais (SLA)">
                                        <field name="sla_hours"/>
                                        <field name="escalation_hours"/>
                                        <field name="escalation_user_id"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Gestion des cas limites" name="edge_cases">
                            <group>
                                <field name="rejection_state"/>
                                <field name="resubmit_from_level_1"/>
                                <field name="allow_self_validation"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_sale_validation_rule_list" model="ir.ui.view">
        <field name="name">dumurosol.sale.validation.rule.list</field>
        <field name="model">dumurosol.sale.validation.rule</field>
        <field name="arch" type="xml">
            <list string="Règles de validation" decoration-danger="has_conflict"
                  decoration-muted="state == 'inactive'" decoration-info="is_default_rule">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'draft'"
                       decoration-muted="state == 'inactive'"/>
                <field name="is_default_rule"/>
                <field name="use_amount_criteria" string="Montant"/>
                <field name="use_customer_criteria" string="Client"/>
                <field name="use_product_criteria" string="Produit"/>
                <field name="use_discount_criteria" string="Remise"/>
                <field name="level_count"/>
                <field name="usage_count"/>
                <field name="has_conflict" widget="boolean_toggle" readonly="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_sale_validation_rule_kanban" model="ir.ui.view">
        <field name="name">dumurosol.sale.validation.rule.kanban</field>
        <field name="model">dumurosol.sale.validation.rule</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="name"/>
                <field name="state"/>
                <field name="has_conflict"/>
                <field name="is_default_rule"/>
                <field name="level_count"/>
                <field name="usage_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="d-flex justify-content-between">
                                <strong t-out="record.name.value"/>
                                <span t-if="record.has_conflict.raw_value"
                                      class="badge text-bg-danger">Conflit</span>
                                <span t-elif="record.is_default_rule.raw_value"
                                      class="badge text-bg-info">Par défaut</span>
                                <span t-elif="record.state.raw_value == 'active'"
                                      class="badge text-bg-success">Active</span>
                                <span t-elif="record.state.raw_value == 'draft'"
                                      class="badge text-bg-warning">Brouillon</span>
                                <span t-else="" class="badge text-bg-secondary">Inactive</span>
                            </div>
                            <div class="text-muted small mt-1">
                                <span t-out="record.level_count.value"/> niveau(x) —
                                <span t-out="record.usage_count.value"/> devis traité(s)
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_sale_validation_rule_search" model="ir.ui.view">
        <field name="name">dumurosol.sale.validation.rule.search</field>
        <field name="model">dumurosol.sale.validation.rule</field>
        <field name="arch" type="xml">
            <search string="Règles de validation">
                <field name="name"/>
                <field name="partner_ids"/>
                <field name="product_category_ids"/>
                <filter string="Actives" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Brouillons" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="En conflit" name="filter_conflict" domain="[('has_conflict', '=', True)]"/>
                <filter string="Règle par défaut" name="filter_default" domain="[('is_default_rule', '=', True)]"/>
                <separator/>
                <filter string="Archivées" name="filter_archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Société" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_validation_rule" model="ir.actions.act_window">
        <field name="name">Règles de validation</field>
        <field name="res_model">dumurosol.sale.validation.rule</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première règle de validation des devis.
            </p>
            <p>
                Une règle combine des critères (montant, client, produit/catégorie,
                remise) et un circuit de validation à un ou plusieurs niveaux.
            </p>
        </field>
    </record>

</odoo>
