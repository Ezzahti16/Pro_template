<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dumurosol" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dumurosol</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='no_edit_order']" position="after">
                <setting id="dumurosol_version_cancel_reason"
                         help="Motif d'annulation appliqué automatiquement au devis d'origine lorsqu'une nouvelle version en est créée">
                    <field name="dumurosol_version_cancel_reason_id" options="{'no_create': True}"/>
                </setting>
                <setting id="dumurosol_divers_product"
                         help="Utiliser ce produit sur une ligne de devis bloque sa confirmation, et masque son nom sur le rapport imprimé au profit de la description saisie. Laisser vide pour désactiver ce contrôle.">
                    <field name="dumurosol_divers_product_id" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
