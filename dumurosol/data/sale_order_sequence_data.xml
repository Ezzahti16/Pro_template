<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Séquence dédiée aux commandes confirmées (devis conserve la séquence
         native Odoo 'sale.order' → S00001). Appliquée une seule fois, à la
         première confirmation, par SaleOrder.action_confirm(). -->
    <record id="seq_sale_order_confirmed" model="ir.sequence">
        <field name="name">Commande confirmée (Dumurosol)</field>
        <field name="code">dumurosol.sale.order.confirmed</field>
        <field name="prefix">CMD</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
