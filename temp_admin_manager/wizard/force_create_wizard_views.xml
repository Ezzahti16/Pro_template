<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tam_force_create_wizard_view_form" model="ir.ui.view">
        <field name="name">tam.force.create.wizard.form</field>
        <field name="model">tam.force.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create anyway?">
                <div class="alert alert-warning" role="alert">
                    <field name="message" nolabel="1" readonly="1" class="mb-0"/>
                </div>
                <field name="database_ids" invisible="1"/>
                <footer>
                    <button name="action_confirm" type="object" class="btn-danger"
                            string="Create Anyway"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
